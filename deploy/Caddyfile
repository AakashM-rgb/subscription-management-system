# Automatic HTTPS (Let's Encrypt) for $DOMAIN. Point the domain's DNS A record at this host.
{$DOMAIN} {
	encode zstd gzip

	# API (including payment-provider webhooks, whose signatures need the untouched raw body)
	# goes straight to FastAPI; everything else is the Next.js app. Same origin => first-party
	# session cookie.
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
}
