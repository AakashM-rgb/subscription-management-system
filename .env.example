# Production settings for `docker compose` (copy to .env, fill in, `chmod 600 .env`).
# NEVER commit .env. Generate secrets with:  openssl rand -base64 48

DOMAIN=billing.example.com

POSTGRES_USER=brightloop
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=brightloop

APP_ENV=production
JWT_SECRET=CHANGE_ME_LONG_RANDOM
COOKIE_SECURE=true
SESSION_TTL_HOURS=8
ALLOWED_ORIGINS=https://billing.example.com
APP_BASE_URL=https://billing.example.com

BUSINESS_TIMEZONE=Asia/Kolkata
CURRENCY=INR
COMPANY_NAME=Brightloop Software
BILLING_HOUR=0
BILLING_MINUTE=5

EMAIL_BACKEND=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Brightloop Billing <billing@billing.example.com>
SMTP_STARTTLS=true

# Automatic collection via Razorpay (leave keys empty to disable autopay; manual payments work).
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
COLLECTION_RETRY_HOURS=24,72,168
DEFAULT_MANDATE_MAX_AMOUNT=100000.00
RECONCILE_AFTER_MINUTES=15

# Backups (deploy/backup.sh)
BACKUP_DIR=/var/backups/brightloop
BACKUP_KEEP_DAYS=14
