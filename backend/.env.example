# Copy to backend/.env and adjust. Never commit .env.
DATABASE_URL=postgresql+psycopg://sms:CHANGE_ME@127.0.0.1:5432/sms_dev
TEST_DATABASE_URL=postgresql+psycopg://sms:CHANGE_ME@127.0.0.1:5432/sms_test
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
SESSION_TTL_HOURS=8
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BUSINESS_TIMEZONE=Asia/Kolkata
CURRENCY=INR
COMPANY_NAME=Brightloop Software

# Public web app URL used in emailed links (reset, invite, invoice)
APP_BASE_URL=http://localhost:3000

# Email: console (logs emails) or smtp
EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Brightloop Billing <billing@brightloop.example.com>
SMTP_STARTTLS=true

# Scheduled billing time (business timezone); an hourly catch-up run also happens
BILLING_HOUR=0
BILLING_MINUTE=5

# Automatic collection (Claude 2: app/providers/config.py). Empty keys => autopay returns 503,
# everything else keeps working. Use Razorpay TEST keys outside production.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
COLLECTION_RETRY_HOURS=24,72,168
DEFAULT_MANDATE_MAX_AMOUNT=100000.00
RECONCILE_AFTER_MINUTES=15

# Autopay safety limits (Claude 2: app/providers/config.py)
PENDING_TIMEOUT_HOURS=72
MAX_PENDING_MANDATES=3
