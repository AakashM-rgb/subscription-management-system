# Copy to .env.local for local development. Never commit real values.

# FastAPI backend base URL (no trailing slash). Used by the /api/v1 rewrite and the server-side
# session check. In Docker Compose this is http://backend:8000.
BACKEND_URL=http://127.0.0.1:8000

# Session cookie name set by the backend (backend setting COOKIE_NAME).
SESSION_COOKIE_NAME=bl_session

# Display settings (public, baked into the client bundle at build time).
NEXT_PUBLIC_CURRENCY=INR
NEXT_PUBLIC_LOCALE=en-IN
NEXT_PUBLIC_TIME_ZONE=Asia/Kolkata
NEXT_PUBLIC_COMPANY_NAME=Brightloop Software

# End-to-end tests (Playwright) only: an existing admin account on the backend under test.
E2E_ADMIN_EMAIL=admin@brightloop.example.com
E2E_ADMIN_PASSWORD=
